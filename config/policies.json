{
  "policies": {
    "DisableAppUpdate": true,
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisableAccounts": true,
    "DisableFeedbackCommands": true,
    "IPProtectionAvailable": false,
    "DontCheckDefaultBrowser": true,
    "DefaultBrowserSettingEnabled": false,
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false,
      "FirefoxLabs": false,
      "WhatsNew": false,
      "Locked": false
    },
    "FirefoxHome": {
      "Search": true,
      "TopSites": true,
      "SponsoredTopSites": false,
      "Stories": false,
      "SponsoredStories": false,
      "Weather": false,
      "Locked": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "OnlineEnabled": false,
      "ImproveSuggest": false,
      "Locked": false
    },
    "Extensions": {
      "Install": [
        "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"
      ]
    },
    "SearchEngines": {
      "Add": [
        {
          "Name": "Doodle",
          "Description": "Derp's search, with results from Google or DuckDuckGo",
          "URLTemplate": "https://www.google.com/search?q={searchTerms}&doodle=1",
          "Method": "GET",
          "SuggestURLTemplate": "https://www.google.com/complete/search?client=firefox&q={searchTerms}&doodle=1",
          "IconURL": "data:image/svg+xml;base64,",
          "Alias": "@doodle"
        }
      ],
      "Default": "Doodle"
    }
  }
}
