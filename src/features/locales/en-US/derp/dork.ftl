# Your dork: Derp's local account (an avatar you design, plus a name).

derp-dork-button =
    .label = Your dork
    .tooltiptext = Your dork
# $name: the name you gave your dork
derp-dork-button-named =
    .label = { $name }
    .tooltiptext = { $name } (your dork)

derp-dork-name =
    .placeholder = Name your dork
    .aria-label = Name
derp-dork-local = Your Derp profile, kept only on this device.

