# Derp's page in Settings.

pane-derp-title = Derp
    .title = Derp
derp-pane-header =
    .heading = Derp

# "Account and sync" becomes Derp's own account page.
derp-pane-you-title = You and your dork
    .title = You and your dork
derp-you-section =
    .heading = You and your dork
derp-dork-group =
    .label = Your dork
    .description = Derp’s account is a cartoon you design. It’s kept on this device and nowhere else: no sign-in, no servers.
derp-dork-card =
    .label = Your dork
    .description = Give your dork a name in the editor.
# $name: the name you gave your dork
derp-dork-card-named =
    .label = { $name }
    .description = Your dork
derp-dork-edit =
    .label = Edit your dork

derp-memory-saver-group =
    .label = Memory Saver
    .description = Unload tabs you haven’t used for a while to free up memory. Pinned tabs, tabs playing sound, picture-in-picture, calls and pages with unsaved changes stay loaded. Unloaded tabs look faded and reload when you open them.
derp-memory-saver =
    .label = Unload inactive tabs
derp-memory-saver-after =
    .label = Unload a tab after
derp-after-15 =
    .label = 15 minutes
derp-after-30 =
    .label = 30 minutes
derp-after-60 =
    .label = 1 hour
derp-after-120 =
    .label = 2 hours
derp-after-240 =
    .label = 4 hours

derp-web-apps-group =
    .label = Web apps
    .description = Install a site as an app with its own window and dock icon. Open the site and click the install button in the address bar; click the same button in the app’s window to uninstall it.
derp-web-apps =
    .label = Show the install button in the address bar

derp-images-group =
    .label = Images
derp-jpeg-xl =
    .label = Show JPEG XL images
    .description = Sites can use .jxl images: smaller files at the same quality.

derp-ai-group =
    .label = AI
    .description = Derp starts with AI enhancements blocked. Translations still work, entirely on your device.
derp-ai-controls-button =
    .label = Open AI controls

derp-fun-group =
    .label = Just for fun
derp-duck =
    .label = Duck mode
    .description = 1 in 10 times you press Enter in the address bar, a duck waddles by and eats what you typed.
derp-snail =
    .label = Snail mode
    .description = When a page takes its time, a snail crawls along the loading bar.
derp-peekaboo =
    .label = Peekaboo
    .description = Now and then, your dork peeks up from the bottom of the window when you open a new tab.
derp-party =
    .label = Party mode
    .description = Confetti when you bookmark a page.
derp-sleepy =
    .label = Sleepy tabs
    .description = Tabs that Memory Saver has put to sleep snore.
derp-power =
    .label = Power typing
    .description = Sparks fly from the address bar as you type.
derp-hiccups =
    .label = Hiccups
    .description = Now and then, a page gets the hiccups. Hic!
derp-ghosts =
    .label = Tab ghosts
    .description = A tab you close drifts away as a little ghost.
derp-rainbow =
    .label = Rainbow mode
    .description = The loading bar is a rainbow.

derp-devices-group =
    .label = Your devices
    .description = Bookmarks, passwords and open tabs, shared between your computer and your phone. End-to-end encrypted, still no account.
derp-devices-none =
    .label = Not paired yet
    .description = Pair Derp on your phone to share with it.
derp-devices-alone-card =
    .label = Waiting for your phone
    .description = Scan the pairing code with your phone’s camera.
# $names: the paired devices, like "Derp on a Pixel 8"
derp-devices-some =
    .label = Paired
    .description = With { $names }
derp-devices-open =
    .label = Your devices

derp-updates-group =
    .label = Updates
    .description = Derp and its Firefox engine update themselves every few hours, checked against their signatures. A new engine is used the next time you open Derp.
derp-updates-check =
    .label = Check for updates
# $version: Derp’s version, like 2.0.0. $engine: the Firefox engine’s, like 159.0.1.
derp-updates-idle =
    .label = Derp { $version }
    .description = Firefox engine { $engine }
derp-updates-checking =
    .label = Checking for updates…
    .description = Derp { $version }, Firefox engine { $engine }
derp-updates-current =
    .label = Derp is up to date
    .description = Derp { $version }, Firefox engine { $engine }
# $new: the version of Derp just installed
derp-updates-updated =
    .label = Derp { $new } is installed
    .description = Restart Derp to use it.
derp-updates-engine =
    .label = A new Firefox engine is ready
    .description = It’s used the next time you open Derp.
derp-updates-busy =
    .label = Derp is already checking for updates
    .description = Try again in a minute.
derp-updates-failed =
    .label = Couldn’t check for updates
    .description = Derp tries again on its own every few hours. Details are in update.log, in Derp’s folder.
