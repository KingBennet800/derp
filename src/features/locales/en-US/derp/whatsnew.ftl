# What's new: a card after an update, with what came with it.

# $version: Derp's version, like 2.1.0
derp-whatsnew-title = What’s new in Derp { $version }
# Over each version's news, when there's more than one. $title: what it was about
derp-whatsnew-version = Derp { $version }: { $title }
derp-whatsnew-done = Nice!
